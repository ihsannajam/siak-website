# ====== Server ======
NODE_ENV=development
PORT=5000
API_PREFIX=/api
CORS_ORIGIN=http://localhost:5173,https://siak-website.vercel.app

# ====== Database (PostgreSQL) ======
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME?schema=public
DATABASE_URL="postgresql://postgres:gOpnpHxRPYYOMWaP@db.rpamjnmubpmuygohqdar.supabase.co:5432/postgres"

# ====== JWT ======
JWT_ACCESS_SECRET=ganti-dengan-secret-acak-yang-panjang-untuk-access-token
JWT_REFRESH_SECRET=ganti-dengan-secret-acak-yang-panjang-untuk-refresh-token
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ====== File upload ======
# Local for development. Set STORAGE_DRIVER=s3 (and implement) for cloud later.
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5

# ====== Rate limit (login) ======
LOGIN_RATE_WINDOW_MINUTES=15
LOGIN_RATE_MAX=10
